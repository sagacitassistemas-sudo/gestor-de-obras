{
  "name": "gestor-de-obras",
  "private": true,
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sagacitassistemas-sudo/gestor-de-obras.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:repair": "fuser -k 8500/tcp 8599/tcp 5173/tcp 2>/dev/null || true && npm run dev",
    "db:restore": "node scripts/restore-local-db.mjs",
    "db:backup": "node scripts/backup-local-db.mjs",
    "prebuild": "node scripts/deploy-db.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "deploy": "npm run lint && npm run test && npm run build",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "check:integrity": "node scripts/check-integrity.mjs",
    "lint": "node scripts/check-integrity.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@svar-ui/react-gantt": "^2.7.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^12.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.9.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^58.4.4",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": "22.x"
  }
}
